{
  "schemaVersion": 1,
  "id": "minigamelib",
  "version": "${version}",
  "name": "Minigame Lib",
  "description": "Server-side cinematics, music and visual utilities for minigames",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "icon": "assets/minigamelib/icon.png",
  "environment": "server",
  "entrypoints": {
    "main": [
      "kim.biryeong.minigamelib.MinigameLibInitializer"
    ]
  },
  "mixins": [
    "minigamelib.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "polymer-core": ">=0.13.13",
    "polymer-resource-pack": ">=0.13.13",
    "polymer-resource-pack-extras": ">=0.13.13",
    "polymer-virtual-entity": ">=0.13.13"
  }
}
